
---
const {titulo,descripcion,icono} = Astro.props
---

<!--Tarjeta de Servicio del sitio E.SOSA-->

<article class="p-6 bg-zinc-900 border-l-4 border-tallerRojo">
    
    <div class="text-3xl mb-4">{icono}</div>
    
    <h3 class="font-titulo text-2xl text-white mb-2 uppercase">
        {titulo}
    </h3>
    
    <p class="font-cuerpo text-gray-400">
        {descripcion}
    </p>

</article>