---
//  src/pages/servicios.astro

// Optimización de Imágenes:
import { imageConfig } from "astro:assets";

// Importaciones de Layouts:
import PlantillaBaseTaller from "../Layouts/PlantillaBase-taller.astro";

//Componentes Globales:
import HeaderTaller from "../Components/HeaderTaller.astro";
import ServicioTaller from "../Components/ServicioTaller.astro";
import FooterTaller from "../Components/FooterTaller.astro";

//Importación de la Lista de Servicios:
import listaServicios from "../Data/servicios.json";
---

<PlantillaBaseTaller>
  <HeaderTaller />

  <main class="main-contenedor">
    <div class="seccion-encabezado">
      
      <span class="seccion-subtitulo">Catálogo Completo</span>

      <h2 class="text-3xl md:text-4xl font-bold text-zinc-900 dark:text-white text-center transition-colors duration-300 mb-2 font-titulo">
        Nuestros <span class="text-taller-rojo">Servicios</span> Más Frecuentes
      </h2>

      <p class="text-center text-zinc-600 dark:text-zinc-400 transition-colors duration-300 max-w-2xl mx-auto mb-12">
        Especialistas en mantener tu vehículo en óptimas condiciones eléctricas.
      </p>
    
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12 pt-4">
      {listaServicios.map((servicio, index) => (
          <ServicioTaller 
              titulo={servicio.titulo}
              descripcion={servicio.descripcion}
              imagen={servicio.imagen}
              beneficios={servicio.beneficios}
              loading={index < 3 ? "eager" : "lazy"}
          />
      ))}
    </div>
  </main>

  <FooterTaller />
</PlantillaBaseTaller>
