
---
const añoActual = new Date().getFullYear();
---

<!--Footer del sitio E.SOSA-->
<footer class="bg-zinc-950 border-t-4 border-tallerRojo text-gray-300 font-cuerpo">

  <!-- Contenido del Footer -->
  <div class="max-w-6xl mx-auto px-6 py-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      
      <!-- Título y descripción -->
      <div class="space-y-4">

        <h2 class="font-titulo text-2xl text-white tracking-wider">
          <span class="text-tallerRojo">E.SOSA</span><br/>Electricidad
        </h2>

        <p class="text-sm leading-relaxed">
          Especialistas en inyección electrónica, arranques y alternadores en San Luis. 
          Tecnología de diagnóstico de avanzada para tu vehículo.
        </p>

      </div>

      <!-- Navegación -->
      <div>

        <h3 class="font-titulo text-lg text-white mb-6 uppercase tracking-widest">Navegación</h3>

        <ul class="space-y-3 text-sm">
          <li><a href="/" class="hover:text-tallerRojo transition-colors">Inicio</a></li>
          <li><a href="/servicios" class="hover:text-tallerRojo transition-colors">Servicios Detallados</a></li>
          <li><a href="/nosotros" class="hover:text-tallerRojo transition-colors">Sobre el Taller</a></li>
          <li><a href="/contacto" class="hover:text-tallerRojo transition-colors">Solicitar Turno</a></li>
        </ul>

      </div>

      <!-- Datos de contacto -->
      <div>
        <h3 class="font-titulo text-lg text-white mb-6 uppercase tracking-widest">Contacto</h3>

        <ul class="space-y-4 text-sm">

          <!-- Ubicación del taller -->
          <li class="flex items-start gap-3">
            <span class="text-tallerRojo">📍</span>
            <span>B134 M262 C17<br/>San Luis, Argentina</span>
          </li>

          <!-- Telefono del taller -->
          <li class="flex items-center gap-3">
            <span class="text-tallerRojo">📞</span>
            <a href="tel:2664193628" class="hover:text-white transition-colors">266-4193628</a>
          </li>

          <!-- Correo del taller -->
          <li class="flex items-center gap-3">
            <span class="text-tallerRojo">✉️</span>
            <span>contacto@esos-electricidad.com.ar</span>
          </li>

        </ul>

      </div>

      <!-- Horarios de Atención -->
      <div>

        <h3 class="font-titulo text-lg text-white mb-6 uppercase tracking-widest">Horarios</h3>

        <ul class="space-y-2 text-sm">

          <li class="flex justify-between">
            <span>Lunes a Viernes:</span>
            <span class="text-white">08:30 - 18:30</span>
          </li>

          <li class="flex justify-between">
            <span>Sábados:</span>
            <span class="text-white">09:00 - 13:00</span>
          </li>

          <li class="flex justify-between border-t border-zinc-800 pt-2 mt-2">
            <span class="text-tallerRojo font-bold italic">Emergencias:</span>
            <span class="text-white font-bold text-xs">Consultar vía WhatsApp</span>
          </li>

        </ul>

      </div>

    </div>

    <div class="border-t border-zinc-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">

      <!-- Derechos reservados -->
      <p class="text-xs text-gray-500">
        © {añoActual} E.SOSA Electricidad Automotriz. Todos los derechos reservados.
      </p>
      
      <!-- Redes sociales -->
      <div class="flex gap-6">
        
        <!-- Facebook del taller -->
        <a href="#" class="text-gray-400 hover:text-tallerRojo transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path></svg>
        </a>

        <!-- Instagram del taller -->
        <a href="#" class="text-gray-400 hover:text-tallerRojo transition-colors">
            <span class="sr-only">Instagram</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
        </a>

      </div>

    </div>

  </div>

</footer>