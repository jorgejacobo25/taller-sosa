---
// src/pages/nosotros.astro

//Importaciones de Layouts:
import PlantillaBaseTaller from '../Layouts/PlantillaBase-taller.astro';

//Componentes Globales:
import HeaderTaller from '../Components/HeaderTaller.astro';
import FooterTaller from '../Components/FooterTaller.astro';

//Importación optimizada de imágenes:
import { Image } from 'astro:assets';
import ImagenHistoria from "../Assets/taller-nosotros/banco de trabajo.jpg"; // Imagen Principal
import ImagenInstalaciones from "../Assets/taller-nosotros/motores.jpg"; // Imagen Secundaria
---

<PlantillaBaseTaller title="Sobre el Taller | E.SOSA Electricidad">
    <HeaderTaller/>
        <main class="flex-grow">
            
            <!-- Sección 1: Encabezado de la Página (Hero de "Nosotros") -->
            <section class="py-12 md:py-16 bg-gradient-to-b from-zinc-100 to-zinc-50 dark:from-zinc-950 dark:to-zinc-900 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-300">
                
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                    <!-- Subtítulo de categoría -->
                    <span class="font-cuerpo font-bold text-taller-rojo tracking-widest uppercase text-xs sm:text-sm mb-3 block">
                        Trayectoria y Compromiso
                    </span>
                    <!-- Título principal H1 -->
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-titulo tracking-tight text-zinc-900 dark:text-white leading-tight mb-6 transition-colors duration-300">
                        Más Sobre Nuestra 
                        <span class="text-taller-rojo">Historia</span>
                    </h1>
                    <!-- Bajada descriptiva -->
                    <p class="text-zinc-600 dark:text-zinc-400 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto transition-colors duration-300">
                        Dedicados al diagnóstico y reparación eléctrica automotriz en San Luis, combinando experiencia de oficio con equipamiento digital de última generación.
                    </p>

                </div>

            </section>

            <!-- Sección 2: Historia del Taller -->
            <section class="py-12 md:py-16 bg-white dark:bg-zinc-900 transition-colors duration-300">
                
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
                        
                        <!-- Columna Izquierda: Imagen de Historia (6 columnas) -->
                        <div class="lg:col-span-6 relative">
                            <div class="relative rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-lg">
                                <Image
                                    src={ImagenHistoria} 
                                        alt="Historia y trabajo en taller E.SOSA"
                                        width={700}
                                        height={450}
                                        format="webp"
                                        loading="eager"
                                        class="w-full h-80 sm:h-96 md:h-[420px] object-cover"
                                />
                            </div>
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent"></div>
                            
                            <div class="absolute bottom-4 left-4 right-4 p-4 bg-zinc-900/90 backdrop-blur-sm rounded-lg border-l-4 border-taller-rojo">                        
                                <p class="text-xs font-bold uppercase tracking-wider text-zinc-300">San Luis, Argentina</p>    
                                <p class="text-sm font-semibold text-white">Especialistas en electricidad de autos y motos</p>
                            </div>
                        </div>

                        <!-- Columna Derecha: Texto de Historia y Origen (6 columnas) -->
                        <div class="lg:col-span-6 flex flex-col items-start">

                            <h2 class="text-2xl sm:text-3xl font-bold font-titulo text-zinc-900 dark:text-white mb-6 transition-colors duration-300">
                                Nacidos de la Pasión por la <span class="text-taller-rojo">Mecánica Eléctrica</span></h2>
                            <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed mb-4 transition-colors duration-300">
                                <strong>E.SOSA Electricidad</strong> inició como un taller enfocado en resolver fallas mecánicas y de encendido tradicionales. Con la rápida evolución automotriz y la llegada de módulos electrónicos complejos, adaptamos nuestras instalaciones y conocimientos para ofrecer diagnósticos certeros.</p>
                            <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed mb-6 transition-colors duration-300">
                                Hoy en día atendemos vehículos particulares, camionetas y motocicletas, garantizando que cada cliente reciba una explicación clara de la falla y un presupuesto transparente antes de realizar cualquier recambio.</p>
                            
                            <!-- Puntos destacados -->
                            <div class="grid grid-cols-2 gap-4 w-full pt-4 border-t border-zinc-200 dark:border-zinc-800">
                                <div>
                                    <span class="block text-xl font-bold text-zinc-900 dark:text-white font-titulo">Atención Directa</span>
                                    <span class="text-xs text-zinc-500 dark:text-zinc-400">Trato personalizado con el especialista.</span>
                                </div>
                                <div>
                                    <span class="block text-xl font-bold text-zinc-900 dark:text-white font-titulo">Sin Sorpresas</span>
                                    <span class="text-xs text-zinc-500 dark:text-zinc-400">Presupuestos previos confirmados.</span>
                                </div>
                            </div>

                        </div>

                    </div>     
                </div>

            </section>
            
            <!-- Sección 3: Valores Y Pilares del trabajo -->
            <section class="py-12 md:py-16 bg-zinc-50 dark:bg-zinc-950 border-y border-zinc-200 dark:border-zinc-800 transition-colors duration-300">
                
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    
                    <div class="text-center max-w-2xl mx-auto mb-12">
                        <span class="font-cuerpo font-bold text-taller-rojo tracking-widest uppercase text-xs mb-2 block">Nuestra Filosofía</span>
                        <h2 class="text-2xl sm:text-3xl font-bold font-titulo text-zinc-900 dark:text-white">Cómo Trabajamos en Cada Reparación</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                        <!-- Tarjeta 1: Precisión -->
                        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm flex flex-col">
                            <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-950/60 text-taller-rojo flex items-center justify-center font-bold text-lg mb-4">
                                01
                            </div>
                            <h3 class="text-lg font-bold font-titulo text-zinc-900 dark:text-white mb-2">Diagnóstico Digital</h3>
                            <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed">
                                No cambiamos piezas por descarte. Utilizamos instrumental de escaneo para detectar el origen exacto del cortocircuito o la falla de inyección.
                            </p>
                        </div>

                        <!-- Tarjeta 2: Repuestos y Garantía -->
                        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm flex flex-col">  
                            <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-950/60 text-taller-rojo flex items-center justify-center font-bold text-lg mb-4">
                                02
                            </div>
                            <h3 class="text-lg font-bold font-titulo text-zinc-900 dark:text-white mb-2">Componentes Confiables</h3>
                            <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed">
                                Trabajamos con repuestos, bobinados y reguladores de marcas líderes que aseguran una vida útil prolongada del sistema eléctrico.
                            </p>
                        </div>

                        <!-- Tarjeta 3: Honestidad Técnica -->
                        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm flex flex-col">
                            <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-950/60 text-taller-rojo flex items-center justify-center font-bold text-lg mb-4">
                                03
                            </div>
                            <h3 class="text-lg font-bold font-titulo text-zinc-900 dark:text-white mb-2">Transparencia Total</h3>
                            <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed">
                                Te mostramos el estado de las piezas extraídas y te explicamos el procedimiento llevado a cabo en tu vehículo de manera sencilla.
                            </p>
                        </div>

                    </div>

                </div>

            </section>

            <!-- Sección 4: Instalaciones y Equipamiento (Invertida)-->
            <section class="py-12 md:py-16 bg-white dark:bg-zinc-900 transition-colors duration-300">

                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

                        <!-- Columna Izquierda: Información de Equipamiento (6 columnas) -->
                        <div class="lg:col-span-6 flex flex-col items-start order-2 lg:order-1"> 
                            <span class="font-cuerpo font-bold text-taller-rojo tracking-widest uppercase text-xs sm:text-sm mb-3 block">
                                Infraestructura
                            </span>
                            
                            <h2 class="text-2xl sm:text-3xl font-bold font-titulo text-zinc-900 dark:text-white mb-6 transition-colors duration-300">   
                                Equipamiento Preparado para <span class="text-taller-rojo">Nuevas Tecnologías</span>
                            </h2>

                            <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed mb-4 transition-colors duration-300">
                                Nuestro espacio de trabajo está acondicionado para la recepción segura de vehículos y motocicletas. Contamos con bancos de prueba de alternadores y motores de arranque, analizadores de baterías y herramientas especializadas para no dañar los circuitos originales del rodado.
                            </p>
                            
                            <div class="flex items-center gap-4 mt-2">
                                <a href="/servicios" class="btn-secundario text-xs sm:text-sm font-bold">
                                    Ver Servicios Disponibles
                                </a>
                            </div>
                        </div>
                        
                        <!-- Columna Derecha: Imagen de Instalaciones (6 columnas) -->
                        <div class="lg:col-span-6 relative order-1 lg:order-2">
                            <div class="relative rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-lg">
                                <Image 
                                    src={ImagenInstalaciones} 
                                    alt="Equipamiento e instalaciones de E.SOSA"
                                    width={700}
                                    height={450}
                                    format="webp"
                                    loading="lazy"
                                    class="w-full h-80 sm:h-96 md:h-[380px] object-cover"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent"></div>
                            </div>
                        </div>

                    </div>

                </div>

            </section>

            <!-- Sección 5: Banner de Contacto / Llamado a la Acción-->
            <section class="py-12 md:py-16 bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300">

                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                    
                    <div class="bg-gradient-to-r from-red-900 via-taller-rojo to-red-800 rounded-2xl p-8 sm:p-12 text-center text-white shadow-xl relative overflow-hidden">
                        
                        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-titulo mb-4">
                            ¿Tu vehículo presenta fallas eléctricas o de arranque?
                        </h2>

                        <p class="text-red-100 text-sm sm:text-base max-w-2xl mx-auto mb-8 leading-relaxed">
                            Agendá una revisión o escaneo computarizado para diagnosticar el problema a tiempo y con precisión.
                        </p>

                        <div class="flex justify-center">
                            <a href="/contacto" class="bg-white text-taller-rojo hover:bg-zinc-100 px-8 py-3.5 rounded font-bold font-cuerpo uppercase tracking-wide text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105">
                                Solicitar Turno Ahora
                            </a>
                        </div>
                    </div>
                
                </div>

            </section>

        </main>
    <FooterTaller/>
</PlantillaBaseTaller>
