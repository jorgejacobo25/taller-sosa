---
// src/Components/ServicioTaller.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  beneficios: string[];
  loading?: "eager" | "lazy"; // Opcional: define la prioridad de carga
}

const { titulo, descripcion, imagen, beneficios, loading = "lazy" } = Astro.props;

const imagenesDisponibles = import.meta.glob<{ default: ImageMetadata }>('/src/Assets/servicios/*.{jpeg,jpg,png,webp}');

if (!imagenesDisponibles[imagen]) {
  throw new Error(`"${imagen}" no existe en: "src/Assets/servicios/"`);
}
---

<article class="card-servicio-detalle group flex flex-col h-full rounded-lg overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-800/80 shadow-md dark:shadow-none transition-colors duration-300">
    
    <div class="h-48 w-full overflow-hidden relative bg-zinc-200 dark:bg-zinc-900">
        <Image 
            src={imagenesDisponibles[imagen]()} 
            alt={titulo} 
            width={600}
            height={400}
            format="webp"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading={loading}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 to-transparent"></div>
    </div>
    
    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-xl font-bold font-titulo text-zinc-900 dark:text-white transition-colors duration-300 mb-3">
            {titulo}
        </h3>
        
        <p class="text-zinc-600 dark:text-zinc-400 transition-colors duration-300 text-sm leading-relaxed mb-6">
            {descripcion}
        </p>

        <ul class="space-y-2 mt-auto text-zinc-700 dark:text-zinc-400 transition-colors duration-300 border-t border-zinc-200 dark:border-zinc-700/60 pt-4 text-xs font-semibold">
            {beneficios.map((beneficio) => (
                <li class="flex items-center gap-2">
                    <span class="text-taller-rojo font-bold">✓</span>
                    <span>{beneficio}</span>
                </li>
            ))}
        </ul>
    </div>

</article>