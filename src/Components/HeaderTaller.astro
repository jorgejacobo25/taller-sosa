---
import { Image } from 'astro:assets';
import logoTaller from '../Assets/logo-taller.png';
---

<!-- Cabecera principal del sitio web E.SOSA -->
<header class="sticky top-0 z-40 bg-gradient-to-r from-taller-rojo via-red-700 to-red-900 dark:from-zinc-950 dark:via-taller-negro dark:to-zinc-900 border-b-2 border-red-950/40 dark:border-taller-rojo/60 shadow-lg transition-colors duration-300">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex justify-between items-center relative z-40">

        <!-- Identidad del sitio: Logo y Nombre -->
        <a href="/" class="group flex items-center gap-3 transition-transform duration-300 hover:scale-102">
            <Image 
                src={logoTaller} 
                alt="Logo E.SOSA Electricidad" 
                width={88}
                height={88}
                format="webp"
                loading="eager"
                class="h-10 sm:h-11 w-auto object-contain rounded-full border border-white/80 dark:border-taller-rojo shadow-sm transition-colors duration-300"
            />
            <div class="flex flex-col">
                <span class="text-white font-bold text-lg leading-none tracking-wide group-hover:text-zinc-100 transition-colors">
                    E.SOSA
                </span>
                <span class="text-red-100 dark:text-zinc-400 text-xs font-medium tracking-wider uppercase">
                    Electricidad
                </span>
            </div>
        </a>

        <!-- Navegación y Acciones para Escritorio -->
        <div class="hidden md:flex items-center gap-6">

            <nav>
                <ul class="flex items-center gap-6 font-cuerpo font-semibold text-xs tracking-wider uppercase">
                    <li>
                        <a href="/" class="text-white hover:text-red-100 dark:text-zinc-300 dark:hover:text-white transition-colors duration-200 py-1 relative after:content-[''] after:absolute after:left-0 after:bottom-0 after:w-full after:h-[2px] after:bg-white dark:after:bg-taller-rojo after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300">
                            Inicio
                        </a>
                    </li>

                    <li>
                        <a href="/servicios" class="text-white hover:text-red-100 dark:text-zinc-300 dark:hover:text-white transition-colors duration-200 py-1 relative after:content-[''] after:absolute after:left-0 after:bottom-0 after:w-full after:h-[2px] after:bg-white dark:after:bg-taller-rojo after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300">
                            Servicios
                        </a>
                    </li>

                    <li>
                        <a href="/nosotros" class="text-white hover:text-red-100 dark:text-zinc-300 dark:hover:text-white transition-colors duration-200 py-1 relative after:content-[''] after:absolute after:left-0 after:bottom-0 after:w-full after:h-[2px] after:bg-white dark:after:bg-taller-rojo after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300">
                            El Taller
                        </a>
                    </li>

                    <li>
                        <a href="/contacto" class="bg-white/10 hover:bg-white text-white hover:text-taller-rojo dark:bg-transparent dark:hover:bg-taller-rojo border border-white/80 dark:border-taller-rojo dark:text-white dark:hover:text-white px-3.5 py-1.5 rounded transition-all duration-300 shadow-sm font-bold">
                            Contacto
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Selector Interactivo de Tema (Escritorio) -->
            <button 
                class="btn-cambiar-tema p-2 rounded-lg text-white/90 hover:text-white hover:bg-white/10 dark:text-zinc-300 dark:hover:text-white dark:hover:bg-zinc-800/80 border border-transparent hover:border-white/20 dark:hover:border-zinc-700 transition-all duration-300 cursor-pointer group" 
                aria-label="Cambiar tema visual"
                title="Cambiar modo de luz"
            >
                <span class="block dark:hidden group-hover:rotate-12 transition-transform duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </span>
                <span class="hidden dark:block group-hover:rotate-45 transition-transform duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </span>
            </button>

        </div>

        <!-- Controles para Dispositivos Móviles -->
        <div class="md:hidden flex items-center gap-2 relative z-50">
            
            <!-- Selector Interactivo de Tema (Móvil) -->
            <button 
                class="btn-cambiar-tema p-2 rounded-lg text-white hover:bg-white/10 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-all duration-300" 
                aria-label="Cambiar tema visual"
            >
                <span class="block dark:hidden">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </span>
                
                <span class="hidden dark:block">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </span>

            </button>

            <!-- Disparador del Menú Lateral Móvil -->
            <button 
                id="btn-menu" 
                class="p-2 text-white hover:bg-white/10 dark:hover:bg-zinc-800 rounded-lg transition-colors focus:outline-none cursor-pointer"
                aria-label="Desplegar menú de navegación"
            >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>

        </div>

    </div>

    <!-- Menú Desplegable Lateral para Móviles (z-50 fijado para estar sobre todo) -->
    <div 
        id="menu-lateral" 
        class="fixed inset-y-0 right-0 w-64 bg-zinc-50 dark:bg-zinc-950 border-l border-zinc-200 dark:border-taller-rojo/40 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 md:hidden flex flex-col pt-20 px-6"
    >
        <ul class="flex flex-col gap-5 font-cuerpo font-semibold text-zinc-800 dark:text-zinc-200 uppercase tracking-wide text-sm">
            <li>
                <a href="/" class="block py-1 hover:text-taller-rojo dark:hover:text-white transition-colors">Inicio</a>
            </li>
            <li>
                <a href="/servicios" class="block py-1 hover:text-taller-rojo dark:hover:text-white transition-colors">Servicios</a>
            </li>
            <li>
                <a href="/nosotros" class="block py-1 hover:text-taller-rojo dark:hover:text-white transition-colors">El Taller</a>
            </li>
            <li class="pt-2 border-t border-zinc-200 dark:border-zinc-800">
                <a href="/contacto" class="block text-center bg-taller-rojo text-white font-bold py-2.5 px-4 rounded shadow-md hover:bg-red-700 transition-colors">
                    Contacto
                </a>
            </li>
        </ul>
    </div>

</header>

<!-- Controlador de interacción en el cliente -->
<script is:inline>

    const inicializarHeader = () => {
        // 1. Control del Cambio de Tema
        const botonesTema = document.querySelectorAll('.btn-cambiar-tema');
        
        const alternarTema = () => {
            const html = document.documentElement;
            html.classList.toggle('dark');
            const esOscuro = html.classList.contains('dark');
            localStorage.setItem('tema', esOscuro ? 'dark' : 'light');
        };

        botonesTema.forEach(boton => {
            boton.removeEventListener('click', alternarTema);
            boton.addEventListener('click', alternarTema);
        });

        // 2. Persistencia del Tema
        if (localStorage.getItem('tema') === 'dark' || (!('tema' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        // 3. Control del Menú Móvil
        const btnMenu = document.getElementById('btn-menu');
        const menuLateral = document.getElementById('menu-lateral');

        if (btnMenu && menuLateral) {
            btnMenu.onclick = (e) => {
                e.stopPropagation();
                menuLateral.classList.toggle('translate-x-full');
            };

            // Cerrar menú si se hace clic fuera de él
            document.onclick = (e) => {
                if (!menuLateral.contains(e.target) && !btnMenu.contains(e.target)) {
                    menuLateral.classList.add('translate-x-full');
                }
            };
        }
    };

    // Ejecutar al cargar la página
    inicializarHeader();

    // Soporte para navegación entre páginas en Astro (View Transitions)
    document.addEventListener('astro:page-load', inicializarHeader);

</script>